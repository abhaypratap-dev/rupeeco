# ---------------------------------------------------------------------------
# Contact form delivery (frontend-only, no backend required)
#
# The site posts form submissions straight from the browser to Web3Forms,
# which emails them to the inbox tied to each access key.
#
# Setup (5 minutes, free tier is enough):
#   1. Go to https://web3forms.com
#   2. Enter director@rupeeco.in -> confirm the email -> copy the access key
#      into NEXT_PUBLIC_WEB3FORMS_KEY_DIRECTOR below
#   3. Repeat for support@rupeeco.in
#   4. Add both in Vercel: Project -> Settings -> Environment Variables
#
# Only DIRECTOR is required. If SUPPORT is missing, those enquiries fall back
# to the DIRECTOR inbox. If neither is set, the form degrades to opening a
# prefilled email in the visitor's mail client.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_WEB3FORMS_KEY_DIRECTOR=
NEXT_PUBLIC_WEB3FORMS_KEY_SUPPORT=
